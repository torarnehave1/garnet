    "label": "Email — login (no)",
    "type": "email-template",
    "info": "<!-- edit:email-body:start -->\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:480px;margin:0 auto;color:#111;background:#ffffff\">\n  <div style=\"background:#0b1220;border-radius:12px 12px 0 0;padding:28px 24px;text-align:center\">\n    <img src=\"{brandLogo}\" width=\"72\" height=\"72\" alt=\"{brandName}\" style=\"display:block;margin:0 auto 12px;border-radius:16px\">\n    <div style=\"color:#e8eef7;font-family:Georgia,serif;font-size:24px;font-weight:bold\">{brandName}</div>\n    <div style=\"color:#8fa0b8;font-family:Georgia,serif;font-style:italic;font-size:14px;margin-top:2px\">De som bøter garnet</div>\n  </div>\n  <div style=\"border:1px solid #e5e7eb;border-top:0;border-radius:0 0 12px 12px;padding:24px\">\n    <p style=\"margin:0 0 12px;font-size:16px\">Klikk knappen under for å logge inn i {brandName}. Lenken utløper om {expiryMinutes} minutter.</p>\n    <p style=\"text-align:center;margin:28px 0\"><a href=\"{magicLink}\" style=\"display:inline-block;background:{brandAccent};color:#0b1220;padding:12px 24px;border-radius:999px;text-decoration:none;font-weight:bold\">Åpne {brandName}</a></p>\n    <p style=\"margin:0 0 12px;color:#555;font-size:14px\">Hvis du ikke ba om denne e-posten, kan du se bort fra den.</p>\n    <p style=\"font-size:12px;color:#888;border-top:1px solid #eee;padding-top:12px;margin:16px 0 0;text-align:center\">{brandFooter}</p>\n  </div>\n</div>\n<!-- edit:email-body:end -->",
